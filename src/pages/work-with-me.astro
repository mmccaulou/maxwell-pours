---
import Base from '../layouts/Base.astro';
import AuthorBio from '../components/AuthorBio.astro';
import { getServices } from '../lib/services';

const restaurantServices = await getServices('restaurants');
const cellarServices = await getServices('cellars');

const FORMSPREE_ENDPOINT = 'https://formspree.io/f/mjygdelv';
---

<Base
  title="Work With Me"
  description="Wine program consulting for independent restaurants and wine bars, and private cellar management in Seattle. Start with a free review."
>

  <!-- =====================================================
       HERO
       ===================================================== -->
  <section class="ww-hero">
    <div class="container ww-hero__inner">
      <p class="ww-hero__eyebrow">Consulting · Seattle</p>
      <h1 class="ww-hero__title">Let's get into wine programs worth running.</h1>
      <p class="ww-hero__sub">
        I build and run them for independent restaurants and wine bars, and help
        private collectors get the most out of their cellars.
      </p>
      <div class="ww-hero__ctas">
        <a
          href="#contact-form"
          class="btn btn--solid btn--large"
          data-preselect="Restaurant"
        >
          Request a Wine List Review
        </a>
        <a
          href="#contact-form"
          class="btn btn--outline btn--large"
          data-preselect="Private Cellar"
        >
          Request a Private Cellar Review
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================
       PROOF BAR
       ===================================================== -->
  <section class="ww-proof">
    <div class="container">
      <ul class="ww-proof__list">
        <li><span class="ww-proof__text">
          Named a best Seattle wine bar by{' '}
          <a href="https://seattle.eater.com/maps/best-wine-bars-seattle#itto-s-vino" target="_blank" rel="noopener">Eater</a>{' '}
          and{' '}
          <a href="https://www.theinfatuation.com/seattle/reviews/ittos-vino" target="_blank" rel="noopener">The Infatuation</a>
        </span></li>
        <li><span class="ww-proof__text">Wine Director for multiple <span class="nowrap">$1M+</span> wine programs</span></li>
        <li><span class="ww-proof__text">Advanced Sommelier candidate, <a href="https://www.mastersommeliers.org" target="_blank" rel="noopener" title="Court of Master Sommeliers" aria-label="CMS (Court of Master Sommeliers)">CMS</a></span></li>
        <li><span class="ww-proof__text">A decade in Seattle wine, and an entire career in beverage</span></li>
      </ul>
    </div>
  </section>

  <!-- =====================================================
       THE PROBLEM
       ===================================================== -->
  <section class="ww-problem">
    <div class="container ww-problem__inner">
      <h2>Well-managed wine should be effortless.</h2>
      <p>
        For a restaurant, that means a dynamic list that sells at a margin that supports your
        business. For a collector, it means knowing what you own and opening it at its best.
        Unfortunately, there are many stagnant cellars out there that lack personality,
        frustrate your accountant, and alienate the guests we pop corks for.
      </p>
    </div>
  </section>

  <!-- =====================================================
       TWO TRACKS
       ===================================================== -->
  <section class="ww-tracks" aria-label="Services">
    <div class="container">

      <!-- Restaurants & Wine Bars -->
      <div class="ww-track">
        <div class="ww-track__head">
          <h3 class="ww-track__title">Restaurants &amp; Wine Bars</h3>
          <p class="ww-track__tagline">For restaurateurs in search of the right list.</p>
        </div>

        <div class="ww-tiers">
          {restaurantServices.map((service) => (
            <div class="ww-card ww-tier">
              <p class="ww-tier__fit">{service.data.tag}</p>
              <h4 class="ww-card__title">
                <a href={`/work-with-me/${service.id}/`} class="ww-tier__link">{service.data.title}</a>
              </h4>
              <p class="ww-card__desc">{service.data.blurb}</p>
              <div class="ww-tier__terms">
                <span>{service.data.billing}</span>
                <span class="ww-tier__price">From <strong>{service.data.price}</strong>{service.data.priceUnit}</span>
              </div>
              <span class="ww-tier__more" aria-hidden="true">Learn more &rarr;</span>
            </div>
          ))}
        </div>

        <p class="ww-track__note">
          Final pricing depends on the size of your program and is quoted after your free review.
        </p>

        <a href="#contact-form" class="btn btn--solid ww-track__start" data-preselect="Restaurant">
          Free Wine List Review
        </a>
      </div>

      <!-- Private Cellars -->
      <div class="ww-track">
        <div class="ww-track__head">
          <h3 class="ww-track__title">Private Cellars</h3>
          <p class="ww-track__tagline">For collectors of bottles in all shapes and sizes.</p>
        </div>

        <div class="ww-tiers">
          {cellarServices.map((service) => (
            <div class="ww-card ww-tier">
              <p class="ww-tier__fit">{service.data.tag}</p>
              <h4 class="ww-card__title">
                <a href={`/work-with-me/${service.id}/`} class="ww-tier__link">{service.data.title}</a>
              </h4>
              <p class="ww-card__desc">{service.data.blurb}</p>
              <div class="ww-tier__terms">
                <span>{service.data.billing}</span>
                <span class="ww-tier__price">From <strong>{service.data.price}</strong>{service.data.priceUnit}</span>
              </div>
              <span class="ww-tier__more" aria-hidden="true">Learn more &rarr;</span>
            </div>
          ))}
        </div>

        <p class="ww-track__note">
          Final pricing depends on the size of your collection and is quoted after your free review.
        </p>

        <a href="#contact-form" class="btn btn--solid ww-track__start" data-preselect="Private Cellar">
          Free Private Cellar Review
        </a>
      </div>

    </div>
  </section>

  <!-- =====================================================
       HOW IT WORKS
       ===================================================== -->
  <section class="ww-how">
    <div class="container">
      <h2>How I Work</h2>
      <ol class="ww-how__list">
        <li>
          <span class="ww-how__num" aria-hidden="true">1</span>
          <span class="ww-how__label">Review</span> at no cost to you.
        </li>
        <li>
          <span class="ww-how__num" aria-hidden="true">2</span>
          <span class="ww-how__label">Plan</span> a clear scope, timeline, and price.
        </li>
        <li>
          <span class="ww-how__num" aria-hidden="true">3</span>
          <span class="ww-how__label">Build</span> the new systems for your list or cellar.
        </li>
        <li>
          <span class="ww-how__num" aria-hidden="true">4</span>
          <span class="ww-how__label">Train</span> your team, or you, to run it.
        </li>
        <li>
          <span class="ww-how__num" aria-hidden="true">5</span>
          <span class="ww-how__label">Maintain</span> with confidence, or keep me around to
          steward our new success.
        </li>
      </ol>
      <p class="ww-how__close">
        Every endeavor finishes with a program built to succeed. Whether you run it or I do is
        up to you.
      </p>
    </div>
  </section>

  <!-- =====================================================
       SELECTED WORK
       ===================================================== -->
  <section class="ww-work">
    <div class="container">
      <h2>Selected Work</h2>
      <div class="ww-work__list">

        <article class="ww-work__item">
          <h3 class="ww-work__title">
            Itto's Vino, Seattle <span class="ww-work__type">(Wine Program Design)</span>
          </h3>
          <p class="ww-work__desc">
            Built a standalone wine bar from an empty room: the list, menus, brand, and POS.
            Wine drove more than half of sales from the first month, a tasting-flight program
            turned curious first-timers into glass-pour regulars, and the bar was named to{' '}
            <a href="https://seattle.eater.com/maps/best-wine-bars-seattle#itto-s-vino" target="_blank" rel="noopener">Eater's</a>{' '}
            and{' '}
            <a href="https://www.theinfatuation.com/seattle/reviews/ittos-vino" target="_blank" rel="noopener">The Infatuation's</a>{' '}
            lists of Seattle's best wine bars.
          </p>
        </article>

        <article class="ww-work__item">
          <h3 class="ww-work__title">
            A Seattle fine-dining program <span class="ww-work__type">(Wine Program Revival)</span>
          </h3>
          <p class="ww-work__desc">
            Directed a wine program doing more than $1M a year in sales. Cut cost of goods by
            more than three points and reduced inventory by a third in nine months, without
            shrinking the guest experience.
          </p>
        </article>

      </div>
    </div>
  </section>

  <!-- =====================================================
       INDEPENDENCE
       ===================================================== -->
  <section class="ww-independence">
    <div class="container ww-independence__inner">
      <p class="ww-independence__lead">I don't take money from distributors or suppliers.</p>
      <p class="ww-independence__sub">
        I've built these relationships over the course of a decade, and they know my integrity
        is paramount.
      </p>
    </div>
  </section>

  <!-- =====================================================
       CONTACT FORM
       ===================================================== -->
  <section class="ww-contact" id="contact-form">
    <div class="container ww-contact__inner">
      <h2>Start with a review.</h2>
      <p class="ww-contact__intro">
        Tell me a little about your restaurant, bar, or cellar, and I'll be in touch within
        48 hours to set up a time.
      </p>

      <form
        class="ww-form"
        action={FORMSPREE_ENDPOINT}
        method="POST"
        id="ww-form"
      >
        <input type="hidden" name="_subject" value="New inquiry — Work With Me" />

        <!-- Honeypot: hidden from sighted users and screen readers, left visible
             to simple bots that fill every input they find. -->
        <div class="ww-form__hp" aria-hidden="true">
          <label for="ww-company">Company</label>
          <input type="text" id="ww-company" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Step 1: pick a review. Each card is a radio option; the fields
             below adapt to the choice (see script). Without JS, all show. -->
        <fieldset class="ww-pick">
          <legend class="sr-only">Choose a review</legend>
          <div class="ww-reviews">
            <div class="ww-card ww-card--free ww-pick__card">
              <label class="ww-pick__label">
                <input type="radio" name="review" value="Wine List Review" class="ww-pick__radio" required />
                <span class="ww-card__badge">Free</span>
                <span class="ww-card__title">Wine List Review</span>
                <span class="ww-card__desc">
                  Send me your list. I'll walk you through what I find on a 30–45 minute call or
                  visit.
                </span>
              </label>
              <details class="ww-pick__details">
                <summary>What's included</summary>
                <ul class="ww-card__list">
                  <li>a snapshot of your list's structure and balance</li>
                  <li>a markup spot-check against retail</li>
                  <li>a read on your by-the-glass program</li>
                  <li>an accuracy and design pass</li>
                  <li>your top three opportunities, ranked by impact</li>
                  <li>one quick win you can act on tomorrow</li>
                </ul>
              </details>
            </div>
            <div class="ww-card ww-card--free ww-pick__card">
              <label class="ww-pick__label">
                <input type="radio" name="review" value="Private Cellar Review" class="ww-pick__radio" />
                <span class="ww-card__badge">Free</span>
                <span class="ww-card__title">Private Cellar Review</span>
                <span class="ww-card__desc">
                  A 60-minute visit to your cellar, wherever it lives.
                </span>
              </label>
              <details class="ww-pick__details">
                <summary>What's included</summary>
                <ul class="ww-card__list">
                  <li>a storage check (temperature, humidity, light, vibration)</li>
                  <li>an organization assessment</li>
                  <li>a "drink these soon" list</li>
                  <li>gaps and strengths, based on what you actually love to drink</li>
                  <li>a recommended next step</li>
                </ul>
              </details>
            </div>
          </div>
          <label class="ww-pick__other">
            <input type="radio" name="review" value="Something else entirely" />
            Something else entirely
          </label>
        </fieldset>

        <div class="ww-form__fields">
          <div class="ww-form__row">
            <label for="ww-name">Name <span aria-hidden="true">*</span></label>
            <input type="text" id="ww-name" name="name" required autocomplete="name" />
          </div>

          <div class="ww-form__row">
            <label for="ww-email">Email <span aria-hidden="true">*</span></label>
            <input type="email" id="ww-email" name="email" required autocomplete="email" />
          </div>

          <div class="ww-form__row">
            <label for="ww-phone">Phone</label>
            <input type="tel" id="ww-phone" name="phone" autocomplete="tel" />
          </div>

          <fieldset class="ww-form__row ww-form__choice" data-show="Wine List Review">
            <legend>What kind of wine are we working with? <span aria-hidden="true">*</span></legend>
            <div class="ww-form__options">
              <label><input type="radio" name="venue" value="Restaurant" /> Restaurant</label>
              <label><input type="radio" name="venue" value="Wine Bar" /> Wine Bar</label>
            </div>
          </fieldset>

          <div class="ww-form__row" data-show="Wine List Review|Private Cellar Review">
            <label for="ww-business">Business name or neighborhood</label>
            <input type="text" id="ww-business" name="business" />
          </div>

          <div class="ww-form__row" data-show="Wine List Review">
            <label for="ww-list-link">Link to your current wine list</label>
            <input type="url" id="ww-list-link" name="wine_list_url" placeholder="https://" />
          </div>

          <div class="ww-form__row">
            <label for="ww-notes">Anything I should know?</label>
            <textarea id="ww-notes" name="notes" rows="4"></textarea>
          </div>

          <button type="submit" class="btn btn--solid ww-form__submit">Request my review</button>

          <p class="ww-form__success" role="status" hidden>
            Thanks, I've got it. I'll be in touch soon to set up your review.
          </p>
          <p class="ww-form__error" role="alert" hidden>
            Something went wrong — please try again, or email me directly.
          </p>
        </div>
      </form>
    </div>
  </section>

  <AuthorBio />

</Base>

<script>
  const form = document.getElementById('ww-form') as HTMLFormElement | null;

  // Step 1 (review cards) drives which follow-up fields show. Rows marked
  // data-show="A|B" appear only for those choices; the venue question is
  // required only for a Wine List Review.
  function syncFields() {
    if (!form) return;
    const choice =
      form.querySelector<HTMLInputElement>('input[name="review"]:checked')?.value ?? '';
    form.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => {
      el.hidden = !(el.dataset.show ?? '').split('|').includes(choice);
    });
    form.querySelectorAll<HTMLInputElement>('input[name="venue"]').forEach((input) => {
      input.required = choice === 'Wine List Review';
    });
  }

  // Buttons around the site preselect with data-preselect / ?interest=
  // (Restaurant, Wine Bar, Private Cellar): pick the card, and the venue.
  const PRESELECT: Record<string, [string, string?]> = {
    Restaurant: ['Wine List Review', 'Restaurant'],
    'Wine Bar': ['Wine List Review', 'Wine Bar'],
    'Private Cellar': ['Private Cellar Review'],
  };

  function preselect(key: string | null | undefined) {
    const match = key ? PRESELECT[key] : undefined;
    if (!form || !match) return;
    const [review, venue] = match;
    const reviewInput = form.querySelector<HTMLInputElement>(`input[name="review"][value="${review}"]`);
    if (reviewInput) reviewInput.checked = true;
    if (venue) {
      const venueInput = form.querySelector<HTMLInputElement>(`input[name="venue"][value="${venue}"]`);
      if (venueInput) venueInput.checked = true;
    }
    syncFields();
  }

  if (form) {
    form.addEventListener('change', (event) => {
      if ((event.target as HTMLInputElement).name === 'review') syncFields();
    });
    syncFields();
    preselect(new URLSearchParams(window.location.search).get('interest'));
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-preselect]').forEach((el) => {
    el.addEventListener('click', () => preselect(el.dataset.preselect));
  });

  // Submit via fetch so we can show the exact success copy in place,
  // without navigating away to Formspree's generic confirmation page.
  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const success = form.querySelector('.ww-form__success') as HTMLElement | null;
      const error = form.querySelector('.ww-form__error') as HTMLElement | null;
      error?.setAttribute('hidden', '');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          // Hide the cards and every field, leaving only the success message
          form.querySelector<HTMLElement>('.ww-pick')?.setAttribute('hidden', '');
          form.querySelectorAll<HTMLElement>('.ww-form__fields > *').forEach((el) => {
            if (el !== success && el !== error) el.setAttribute('hidden', '');
          });
          success?.removeAttribute('hidden');
        } else {
          error?.removeAttribute('hidden');
        }
      } catch {
        error?.removeAttribute('hidden');
      }
    });
  }
</script>

<style>
/* Pink .btn styles live in global.css (also used by the service pages). */


/* ============================================================
   HERO
   ============================================================ */

.ww-hero { padding-block: 3.5rem 2.5rem; }

.ww-hero__inner { max-width: 44rem; }

.ww-hero__eyebrow {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--hot-pink);
  margin-bottom: 0.875rem;
  max-width: none;
}

.ww-hero__title {
  color: var(--ink);
  max-width: 18ch;
}

.ww-hero__sub {
  font-size: clamp(1.0625rem, 2vw, 1.25rem);
  color: var(--muted-ink);
  line-height: 1.55;
  margin-top: 1.25rem;
  max-width: 48ch;
}

.ww-hero__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

@media (min-width: 768px) {
  .ww-hero { padding-block: 5rem 3rem; }
}


/* ============================================================
   PROOF BAR
   ============================================================ */

.ww-proof {
  background-color: var(--deep-cream);
  padding-block: 1.5rem;
}

/* Each achievement is its own cell, so wrapping happens inside an item,
   never midway through the row. Phones: stacked. Tablet: 2×2. Desktop: 4 across. */
.ww-proof__list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
  list-style: none;
  padding: 0;
  margin: 0;
}

.ww-proof__list li {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--plum);
  text-align: center;
  line-height: 1.4;
  text-wrap: balance;
}

/* Phones: thin plum rule between stacked items, echoing the desktop dividers */
@media (max-width: 559px) {
  .ww-proof__list { gap: 0; }

  .ww-proof__list li {
    padding-block: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--plum) 25%, transparent);
  }

  .ww-proof__list li:first-child { border-top: none; padding-top: 0; }
  .ww-proof__list li:last-child { padding-bottom: 0; }
}

@media (min-width: 560px) {
  .ww-proof__list {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
  }
}

@media (min-width: 960px) {
  .ww-proof__list {
    /* one column per item, however many there are */
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 0;
  }

  .ww-proof__list li {
    padding-inline: 1.25rem;
    border-left: 1px solid color-mix(in srgb, var(--plum) 25%, transparent);
  }

  .ww-proof__list li:first-child { border-left: none; }
}

/* Tablet + desktop: items share a row, so center each item's text
   vertically; a 2-line item sits level with a 3-line neighbor and the
   dividers stay full height. The span keeps text and links in one flow. */
@media (min-width: 560px) {
  .ww-proof__list li {
    display: flex;
    align-items: center;
    justify-content: center;
  }
}

.ww-proof__list .nowrap { white-space: nowrap; }

/* Publication links: same plum as the banner text, marked by underline */
.ww-proof__list a {
  white-space: nowrap;   /* keep each publication name on one line */
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
}
.ww-proof__list a:hover { text-decoration-thickness: 2px; }
.ww-proof__list a:focus-visible {
  outline: 2px solid var(--petrol);
  outline-offset: 2px;
  border-radius: 2px;
}


/* ============================================================
   THE PROBLEM
   ============================================================ */

.ww-problem { padding-block: 4rem 3rem; }

.ww-problem__inner {
  max-width: var(--prose-width);
  text-align: left;
}

.ww-problem__inner h2 { margin-bottom: 1.25rem; }

.ww-problem__inner p {
  font-size: 1.0625rem;
  line-height: 1.75;
  color: var(--ink);
  max-width: 62ch;
}


/* ============================================================
   TWO TRACKS
   ============================================================ */

.ww-tracks { padding-block: 2rem 3rem; }

/* Each audience gets its own full-width row; its three services sit side by
   side as parallel options rather than stacking like a sequence. */
.ww-track + .ww-track {
  margin-top: 3.5rem;
  padding-top: 3.5rem;
  border-top: 1px solid color-mix(in srgb, var(--petrol) 20%, transparent);
}

.ww-track__head { margin-bottom: 1.5rem; }

.ww-track__note {
  font-size: 0.8125rem;
  color: var(--muted-ink);
  margin-top: -0.5rem;
  margin-bottom: 1.25rem;
}

.ww-tiers {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
  margin-bottom: 1.5rem;
}

@media (min-width: 860px) {
  .ww-tiers { grid-template-columns: repeat(3, 1fr); }
}

.ww-track__title {
  color: var(--ink);
  margin-bottom: 0.375rem;
}

.ww-track__tagline {
  font-size: 0.9375rem;
  color: var(--muted-ink);
  max-width: none;
}

.ww-track__start { margin-top: 0.25rem; }
.ww-track__start:focus-visible { outline: 2px solid var(--petrol); outline-offset: 2px; }

.ww-card {
  background-color: var(--lifted-cream);
  border: 1.5px solid color-mix(in srgb, var(--petrol) 20%, transparent);
  border-radius: 6px;
  padding: 1.5rem;
  margin-bottom: 1.25rem;
}

/* Tier cards: "who it's for" label up top, engagement terms pinned to the
   bottom so all three line up across the row regardless of copy length. */
.ww-tier {
  display: flex;
  flex-direction: column;
  margin-bottom: 0;
  background-color: var(--deep-cream);
}

.ww-tier__fit {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--petrol);
  margin-bottom: 0.5rem;
  max-width: none;
}

.ww-tier__terms {
  display: flex;
  flex-wrap: wrap;            /* phones: price drops under the label if the row is too tight */
  justify-content: space-between;
  gap: 0.25rem 1rem;
  margin-top: auto;
  padding-top: 1rem;
  border-top: 1px solid color-mix(in srgb, var(--petrol) 20%, transparent);
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--ink);
  max-width: none;
}

/* Whole card is clickable: the title link's ::after stretches over the card,
   so there's one link per card. Its focus ring outlines the full card. */
.ww-tier {
  position: relative;
  transition: border-color 0.18s;
}
